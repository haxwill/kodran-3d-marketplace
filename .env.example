# KODRAN.DEV - Environment Configuration Template
# Copy to .env for local runtime. Never commit production credentials.

NODE_ENV=production
PORT=3000

# Redis Distributed Session & Rate Limiting URL
REDIS_URL=redis://127.0.0.1:6379

# Bcrypt Hash of Production Admin Password (Minimum 12 rounds)
ADMIN_PASSWORD_HASH=

# High-entropy session secret for cookie signing (Hex 256-bit)
SESSION_SECRET=

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=https://kodran.dev
